# Copy to mobile/.env. Expo inlines EXPO_PUBLIC_* values at build time, so nothing secret here:
# the access token is entered in the app and kept in the device's keychain.
# Backend URL as the phone reaches it (HTTPS in production; in the iOS Simulator
# http://127.0.0.1:8000 works, on a real phone use your computer's LAN IP).
EXPO_PUBLIC_API_URL=https://coach.example.com
EXPO_PUBLIC_STRAVA_CLIENT_ID=12345
