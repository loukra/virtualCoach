# Copy to mobile/.env. Expo inlines EXPO_PUBLIC_* values at build time.
# Backend URL as the phone reaches it (HTTPS in production, your laptop's LAN IP in development).
EXPO_PUBLIC_API_URL=https://coach.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key only. Never put the service-role key into the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
EXPO_PUBLIC_STRAVA_CLIENT_ID=12345
