# Copy to backend/.env and fill in. Never commit the real file.

SUPABASE_URL=https://your-project.supabase.co
# Service-role (secret) key: the backend writes on the user's behalf and bypasses RLS.
SUPABASE_SERVICE_KEY=sb_secret_...

OPENAI_API_KEY=sk-...

STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=...

# Your Supabase user id (Authentication > Users). Everyone else gets 403.
ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000

# Optional
# TIMEZONE=Europe/Berlin
# PLAN_MODEL=gpt-5-mini
# WORKOUT_MODEL=gpt-5-mini
# AI_MAX_ATTEMPTS=3
# LOG_LEVEL=INFO
